# --- Discord Bot Token ---
# DISCORD_TOKEN= or DISCORD_BOT_TOKEN= (either works)

# --- Groq (OpenAI-compatible; used by the `ask` command and the AI channel) ---
# Get a key at https://console.groq.com/keys — never commit your real .env file.
GROQ_API_KEY=

# --- Turso database (hosted SQLite) ---
# Create a free database at https://turso.tech and paste its URL + token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
