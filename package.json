{
	"name": "bangalore",
	"version": "3.0.0",
	"description": "Bangalore Hub community bot",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"db:start": "npx prisma generate && npx prisma db push",
		"dev:start": "node dist/index.js",
		"start": "npm run db:start && npm run watch:start",
		"watch:start": "tsc-watch --onSuccess \"node ./dist/index.js\"",
		"start:prod": "npx prisma db push && node dist/index.js",
		"deploy": "catalyst deploy --only appsail -ni && curl -s -m 20 https://community-bot-50047512140.development.catalystappsail.in/health"
	},
	"author": "Lorenz",
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "^6.16.2",
		"axios": "^1.12.2",
		"common-tags": "^1.8.2",
		"consola": "^3.4.2",
		"cron": "^4.3.3",
		"discord-html-transcripts": "^3.2.0",
		"discord.js": "^14.28.0",
		"dotenv": "^17.2.3",
		"emoji-regex": "^10.6.0",
		"ms": "^2.1.3",
		"prisma": "^6.16.2"
	},
	"devDependencies": {
		"@types/common-tags": "^1.8.4",
		"@types/cron": "^2.4.3",
		"@types/ms": "^2.1.0",
		"@types/node": "^22.19.3",
		"tsc-watch": "^7.1.1",
		"typescript": "^5.9.3"
	},
	"prisma": {
		"schema": "./src/prisma/schema.prisma"
	},
	"engines": {
		"node": ">=18"
	}
}
